@page "/login"

@using System.Net.Http.Json
@using GestionOrdinateurs.Client.Services
@using Blazored.SessionStorage
@inject IHttpClientFactory HttpClientFactory
@inject ISessionStorageService SessionStorage
@inject JwtAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Connexion</PageTitle>

<h1>Connexion</h1>

<div class="col-md-6">
    <label for="login" class="form-label">Login</label>
    <InputText id="login" class="form-control" @bind-Value="login" />

    <label for="password" class="form-label mt-3">Mot de passe</label>
    <InputText id="password" type="password" class="form-control" @bind-Value="password" />

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mt-3">@errorMessage</div>
    }

    <button class="btn btn-primary mt-3" @onclick="Connect" disabled="@isConnecting">
        @(isConnecting ? "Connexion..." : "Se connecter")
    </button>
</div>

@code {
    private string login = string.Empty;
    private string password = string.Empty;
    private string? errorMessage;
    private bool isConnecting;

    private async Task Connect()
    {
        errorMessage = null;
        isConnecting = true;

        try
        {
            var client = HttpClientFactory.CreateClient("AuthenticationApi");
            // Ancien login (TP5) : api/Authentication avec le login seul
            // Nouveau login (TP6) : api/Auth/login, AuthentificationApi demande le token à Keycloak
            using var response = await client.PostAsJsonAsync(
                "api/Auth/login",
                new LoginRequest(login, password));

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = response.StatusCode == System.Net.HttpStatusCode.Unauthorized
                    ? "Login ou mot de passe incorrect."
                    : "La connexion a échoué.";
                return;
            }

            // Réponse de Keycloak : on ne garde que l'access_token
            var tokenResponse = await response.Content.ReadFromJsonAsync<TokenResponse>();
            var token = tokenResponse?.AccessToken;
            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "La réponse de l'API d'authentification est invalide.";
                return;
            }

            await SessionStorage.SetItemAsync("jwtToken", token);
            AuthenticationStateProvider.NotifyUserAuthentication(token);
            Navigation.NavigateTo("/");
        }
        catch (HttpRequestException)
        {
            errorMessage = "L'API d'authentification est inaccessible.";
        }
        finally
        {
            isConnecting = false;
        }
    }
    private record LoginRequest(string Username, string Password);

    private record TokenResponse(
        [property: System.Text.Json.Serialization.JsonPropertyName("access_token")] string AccessToken);
}
